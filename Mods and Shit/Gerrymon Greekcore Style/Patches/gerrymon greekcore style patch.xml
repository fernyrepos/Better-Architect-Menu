		</match>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>Defs/ThingDef[defName="Greekcore_Slab_Medium"]</xpath>
			<value><designationCategory>Ferny_FloorsStone</designationCategory></value>
		</nomatch>
	</Operation>

	<!-- Ferny_Walls -->
