<?xml version="1.0" encoding="utf-8"?>
<Patch>
	
<!-- ANIMAL BEDDING -->

	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="DragonNest"]/designationCategory</xpath>
		<value>
			<designationCategory>Ferny_AnimalBedding</designationCategory>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="DragonPillow"]/designationCategory</xpath>
		<value>
			<designationCategory>Ferny_AnimalBedding</designationCategory>
		</value>
	</Operation>

<!-- RANCHING -->

	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="BasicIncubator"]/designationCategory</xpath>
		<value>
			<designationCategory>Ferny_Ranching</designationCategory>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="AdvancedIncubator"]/designationCategory</xpath>
		<value>
			<designationCategory>Ferny_Ranching</designationCategory>
		</value>
	</Operation>
	
	<!-- If Ideology IS loaded -->
	<Operation Class="PatchOperationFindMod">
	<mods>
		<li>Ideology</li>
	</mods>
	<match Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="Altar"]/designationCategory</xpath>
		<value>
		<designationCategory>Ideology</designationCategory>
		</value>
	</match>
	</Operation>

	<Operation Class="PatchOperationFindMod">
	<mods>
		<li>Ideology</li>
	</mods>
	<nomatch Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="Altar"]/designationCategory</xpath>
		<value>
		<designationCategory>Ferny_Memorial</designationCategory>
		</value>
	</nomatch>
	</Operation>

	<!-- Additional buildings sorted (generated from an in-game export of the architect tree) -->
<!-- Ferny_Summon -->
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="DDOfferingSpot"]/designationCategory</xpath>
		<value><designationCategory>Ferny_Summon</designationCategory></value>
	</Operation>
</Patch>
