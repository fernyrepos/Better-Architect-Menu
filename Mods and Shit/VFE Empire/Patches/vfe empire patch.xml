<?xml version="1.0" encoding="utf-8" ?>
<Patch>   
<!-- LIGHTING -->
	
    <Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/ThingDef[defName="VFEE_Candelabra"]/designationCategory</xpath>
        <value>
            <designationCategory>Ferny_Lighting</designationCategory>
        </value>
    </Operation>

<!-- BEDROOM -->
	
    <Operation Class="PatchOperationAdd">
        <success>Always</success>
        <xpath>Defs/ThingDef[defName="VFEE_RoyalMirror"]</xpath>
        <value>
            <designationCategory>Ferny_Bedroom</designationCategory>
        </value>
    </Operation>

<!-- TABLES -->
	
    <Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/ThingDef[defName="VFEE_GrandTable"]/designationCategory</xpath>
        <value>
            <designationCategory>Ferny_Tables</designationCategory>
        </value>
    </Operation>

<!-- CHAIRS -->
	
    <Operation Class="PatchOperationAdd">
        <success>Always</success>
        <xpath>Defs/ThingDef[defName="VFEE_GrandChair"]</xpath>
        <value>
            <designationCategory>Ferny_Seating</designationCategory>
        </value>
    </Operation>
	
    <Operation Class="PatchOperationAdd">
        <success>Always</success>
        <xpath>Defs/ThingDef[defName="VFEE_RoyalStool"]</xpath>
        <value>
            <designationCategory>Ferny_Seating</designationCategory>
        </value>
    </Operation>
	
    <Operation Class="PatchOperationAdd">
        <success>Always</success>
        <xpath>Defs/ThingDef[defName="VFEE_StellicThrone"]</xpath>
        <value>
            <designationCategory>Ferny_Meditation</designationCategory>
        </value>
    </Operation>

<!-- DECORATIONS -->
	
    <Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/ThingDef[defName="VFEE_ImperialBanner"]/designationCategory</xpath>
        <value>
            <designationCategory>Ferny_DecoHanging</designationCategory>
        </value>
    </Operation>

<!-- RUGS -->
	
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[@Name="VFEE_BuildingFloorBase"]/designationCategory</xpath>
		<value>
			<designationCategory>Ferny_DecoRugs</designationCategory>
		</value>
	</Operation>

	<!-- Additional buildings sorted (generated from an in-game export of the architect tree) -->
<!-- Ferny_DecoRugs -->
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="VFEE_GrandRoyalRug"]/designationCategory</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="VFEE_GrandRoyalRug"]/designationCategory</xpath>
			<value><designationCategory>Ferny_DecoRugs</designationCategory></value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>Defs/ThingDef[defName="VFEE_GrandRoyalRug"]</xpath>
			<value><designationCategory>Ferny_DecoRugs</designationCategory></value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="VFEE_LargeRoyalRug"]/designationCategory</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="VFEE_LargeRoyalRug"]/designationCategory</xpath>
			<value><designationCategory>Ferny_DecoRugs</designationCategory></value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>Defs/ThingDef[defName="VFEE_LargeRoyalRug"]</xpath>
			<value><designationCategory>Ferny_DecoRugs</designationCategory></value>
		</nomatch>
	</Operation>

	<!-- Ferny_FloorsStone -->
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="VFEE_ImperialSlab"]/designationCategory</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="VFEE_ImperialSlab"]/designationCategory</xpath>
			<value><designationCategory>Ferny_FloorsStone</designationCategory></value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>Defs/ThingDef[defName="VFEE_ImperialSlab"]</xpath>
			<value><designationCategory>Ferny_FloorsStone</designationCategory></value>
		</nomatch>
	</Operation>
</Patch>
