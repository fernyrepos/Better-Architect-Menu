			<xpath>Defs/ThingDef[defName="Reverse_Engineered_SmokeSpewer"]/designationCategory</xpath>
			<value><designationCategory>Ferny_Pollution</designationCategory></value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>Defs/ThingDef[defName="Reverse_Engineered_SmokeSpewer"]</xpath>
