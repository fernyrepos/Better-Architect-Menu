<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>
      Defs/ThingDef[@Name="Reverse_Engineered_ConditionCauserBase"]/designationCategory
    </xpath>
    <value>
      <designationCategory>Ferny_Terraforming</designationCategory>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>
      Defs/ThingDef[@Name="Reverse_Engineered_ConditionCauserBase"]/designatorDropdown
    </xpath>
  </Operation>

	<!-- Additional buildings sorted (generated from an in-game export of the architect tree) -->
<!-- Ferny_Pollution -->
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="Reverse_Engineered_SmokeSpewer"]/designationCategory</xpath>
