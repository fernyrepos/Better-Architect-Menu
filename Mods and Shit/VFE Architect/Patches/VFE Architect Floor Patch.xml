<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/TerrainTemplateDef[defName="VFEArch_WoolCarpet"]</xpath>
        <value>
            <li Class="BetterArchitect.TemplateCategoryExtension">
                <designationCategory>Ferny_FloorsCarpet</designationCategory>
            </li>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/TerrainDef[defName="SterileTile"]</xpath>
        <value>
            <designationCategory>Ferny_FloorsClean</designationCategory>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/TerrainDef[defName="VFEArch_Asphalt" or defName="VFEArch_PlayerBrokenAsphalt"]</xpath>
        <value>
            <designationCategory>Ferny_FloorsConcrete</designationCategory>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/TerrainDef[@Name="TileMetalBase" or @Name="FineMetalTileBase"]</xpath>
        <value>
            <designationCategory>Ferny_FloorsMetal</designationCategory>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/TerrainDef[@Name="CobblestoneBase"
            or @Name="PolishedStoneFloorBase"
            or @Name="StoneSlabsBase"]</xpath>
        <value>
            <designationCategory>Ferny_FloorsStone</designationCategory>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/TerrainDef[@Name="VFEArch_WoodenParquetBase"
            or defName="VFEArch_WoodPlankFloorWalnut"
            or defName="VFEArch_WoodPlankFloorBirch"
            or defName="VFEArch_WoodPlankFloorMahogany"
            or defName="VFEArch_FineWoodenFloor"
            or defName="VFEArch_FineWoodenFloorWalnut"
            or defName="VFEArch_FineWoodenFloorBirch"
            or defName="VFEArch_FineWoodenFloorMahogany"]</xpath>
        <value>
            <designationCategory>Ferny_FloorsWood</designationCategory>
        </value>
    </Operation>

    <!-- FREE -->
    <Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/TerrainDef[defName="VFEArch_Grass"]/designationCategory</xpath>
        <value>
            <designationCategory>Ferny_FloorsFree</designationCategory>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/TerrainDef[defName="VFEArch_LawnPlot"]/designationCategory</xpath>
        <value>
            <designationCategory>Ferny_FloorsFree</designationCategory>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/TerrainDef[defName="VFEArch_PlayerPackedDirt"]/designationCategory</xpath>
        <value>
            <designationCategory>Ferny_FloorsFree</designationCategory>
        </value>
    </Operation>

</Patch>