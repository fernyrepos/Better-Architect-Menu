	</Operation>
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="WateryGrave"]/designationCategory</xpath>
		<value><designationCategory>Ferny_Memorial</designationCategory></value>
	</Operation>
</Patch>
