<?xml version="1.0" encoding="utf-8" ?>
<Patch>   

<!-- LIGHTING -->
                <Operation Class="PatchOperationReplace">
                    <success>Always</success>
                    <xpath>Defs/ThingDef[defName="WallSunLampSoS"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Ferny_Lighting</designationCategory>
                    </value>
                </Operation>

<!-- POWER GENERATION -->
                <Operation Class="PatchOperationReplace">
                    <success>Always</success>
                    <xpath>Defs/ThingDef[defName="VanometricPowerCell"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Ferny_PowerGeneration</designationCategory>
                    </value>
                </Operation>



<!-- SPACE -->
                <Operation Class="PatchOperationReplace">
                    <xpath>Defs/TerrainDef[defName="SoilShip"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Ship</designationCategory>
                    </value>
                </Operation>
                <Operation Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="HullFoamWall"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Ship</designationCategory>
                    </value>
                </Operation>
                <Operation Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="ShipHullfoamTile"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Ship</designationCategory>
                    </value>
                </Operation>

<!-- PROCESSING PRODUCTION -->
                <Operation Class="PatchOperationReplace">
                    <success>Always</success>
                    <xpath>Defs/ThingDef[defName="ArchoRecycler"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Ferny_ProcessingProduction</designationCategory>
                    </value>
                </Operation>

  <!-- AERIAL TRANSPORT -->
  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>Defs/Vehicles.VehicleBuildDef[defName="SoS2_Shuttle_Personal_Blueprint"]</xpath>
    <value>
      <designationCategory>Ferny_AerialTransport</designationCategory>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>Defs/Vehicles.VehicleBuildDef[defName="SoS2_Shuttle_Standard_Blueprint"]</xpath>
    <value>
      <designationCategory>Ferny_AerialTransport</designationCategory>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>Defs/Vehicles.VehicleBuildDef[defName="SoS2_Shuttle_Heavy_Blueprint"]</xpath>
    <value>
      <designationCategory>Ferny_AerialTransport</designationCategory>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>Defs/Vehicles.VehicleBuildDef[defName="SoS2_Shuttle_Superheavy_Blueprint"]</xpath>
    <value>
      <designationCategory>Ferny_AerialTransport</designationCategory>
    </value>
  </Operation>

</Patch>