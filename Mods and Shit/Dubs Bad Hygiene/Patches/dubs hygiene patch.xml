<?xml version="1.0" encoding="utf-8" ?>
<Patch>   

                <Operation Class="PatchOperationReplace">
                <xpath>Defs/DesignationCategoryDef[defName="Hygiene"]/label</xpath>
                    <value>
                        <label>Water</label>
                    </value>
                </Operation>

              <Operation Class="PatchOperationConditional">
             <xpath>/Defs/DesignationCategoryDef[defName="VCHE_PipeNetworks"]</xpath>
                <match Class="PatchOperationAdd">
                    <success>Always</success>
                    <xpath>Defs/DesignationCategoryDef[defName="Hygiene"]</xpath>
                    <value>
                        <modExtensions>
                        <li Class="BetterArchitect.NestedCategoryExtension">
                            <parentCategory>VCHE_PipeNetworks</parentCategory>
                        </li>
                        </modExtensions>
                    </value>
                </match>
              </Operation>

	<!--  Move shit      -->
                <Operation Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[@Name="BasedHeating"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Hygiene</designationCategory>
                    </value>
                </Operation>
                <Operation Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="SolarHeater"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Hygiene</designationCategory>
                    </value>
                </Operation>
                    <Operation Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="GeothermHeater"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Hygiene</designationCategory>
                    </value>
                </Operation>
                <Operation Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="WashingMachine"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Hygiene</designationCategory>
                    </value>
                </Operation>
                <Operation Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[@Name="BasedCeilingFan"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Ferny_Cooling</designationCategory>
                    </value>
                </Operation>

	<!-- Additional buildings sorted (generated from an in-game export of the architect tree) -->
<!-- Ferny_AirManagement -->
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="airPipe"]/designationCategory</xpath>
		<value><designationCategory>Ferny_AirManagement</designationCategory></value>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="airPipeHidden"]/designationCategory</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="airPipeHidden"]/designationCategory</xpath>
			<value><designationCategory>Ferny_AirManagement</designationCategory></value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>Defs/ThingDef[defName="airPipeHidden"]</xpath>
			<value><designationCategory>Ferny_AirManagement</designationCategory></value>
		</nomatch>
	</Operation>

	<!-- Ferny_Cooling -->
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="AirconIndoorUnit"]/designationCategory</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="AirconIndoorUnit"]/designationCategory</xpath>
			<value><designationCategory>Ferny_Cooling</designationCategory></value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>Defs/ThingDef[defName="AirconIndoorUnit"]</xpath>
			<value><designationCategory>Ferny_Cooling</designationCategory></value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="AirConOutdoorUnit"]/designationCategory</xpath>
		<value><designationCategory>Ferny_Cooling</designationCategory></value>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="FreezerUnit"]/designationCategory</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="FreezerUnit"]/designationCategory</xpath>
			<value><designationCategory>Ferny_Cooling</designationCategory></value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>Defs/ThingDef[defName="FreezerUnit"]</xpath>
			<value><designationCategory>Ferny_Cooling</designationCategory></value>
		</nomatch>
	</Operation>

	<!-- Floors (TerrainDef) -->
	<Operation Class="PatchOperationAdd">
		<success>Always</success>
		<xpath>Defs/TerrainDef[defName="DBHMosaicGranite" or defName="DBHMosaicLimestone" or defName="DBHMosaicMarble" or defName="DBHMosaicSandstone" or defName="DBHMosaicSlate"]</xpath>
		<value><designationCategory>Ferny_FloorsStone</designationCategory></value>
	</Operation>
</Patch>