<?xml version="1.0" encoding="utf-8" ?>
<Patch>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[@Name="sbz_BookcaseBase"]/designationCategory</xpath>
        <match Class="PatchOperationReplace">
            <success>Always</success>
            <xpath>Defs/ThingDef[@Name="sbz_BookcaseBase"]/designationCategory</xpath>
            <value>
                <designationCategory>Ferny_InformationStorage</designationCategory>
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <success>Always</success>
            <xpath>Defs/ThingDef[@Name="sbz_BookcaseBase"]</xpath>
            <value>
                <designationCategory>Ferny_InformationStorage</designationCategory>
            </value>
        </nomatch>
    </Operation>

</Patch>
