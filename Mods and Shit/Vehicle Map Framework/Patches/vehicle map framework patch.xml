<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- Use VMF's own category in the former Transport > Platform position. -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/DesignationCategoryDef[defName="VMF_VehicleMap"]/label</xpath>
        <value><label>Platform</label></value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/DesignationCategoryDef[defName="VMF_VehicleMap"]/order</xpath>
        <!-- Nested categories sort descending: vehicle types (7), Platform (3), Infrastructure (2). -->
        <value><order>3</order></value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/DesignationCategoryDef[defName="VMF_VehicleMap"]</xpath>
        <value>
            <modExtensions>
                <li Class="BetterArchitect.NestedCategoryExtension">
                    <parentCategory>Ferny_Transport</parentCategory>
                </li>
            </modExtensions>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/DesignationCategoryDef[defName="VMF_VehicleMap"]/specialDesignatorClasses</xpath>
        <value>
            <li>Vehicles.Designator_AreaRoadExpand</li>
            <li>Vehicles.Designator_AreaRoadClear</li>
        </value>
    </Operation>
	

<!-- Remove dropdowns -->

	<Operation Class="PatchOperationRemove">
		<success>Always</success>
		<xpath>Defs/DesignatorDropdownGroupDef[defName="VMF_WirelessChargerGroup"]</xpath>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="VMF_WirelessTransmitter"]/designatorDropdown</xpath>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="VMF_WirelessReceiver"]/designatorDropdown</xpath>
	</Operation>



