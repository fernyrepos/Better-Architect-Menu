				<!-- <li Class="PatchOperationRemove">
					<success>Always</success>
					<xpath>Defs/ThingDef[@Name="VMF_GravshipWheelBase"]/designatorDropdown</xpath>
				</li> -->
				
			</operations>
		</match>
	</Operation>

<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ThingDef[defName="VMF_WirelessTransmitter"]/designationCategory</xpath>
