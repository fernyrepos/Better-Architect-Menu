<?xml version="1.0" encoding="utf-8" ?>
<Patch>

<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ThingDef[defName="MUM_MaterialsWorkshop"]/designationCategory</xpath>
    <value>
        <designationCategory>Ferny_ProcessingProduction</designationCategory>
    </value>
</Operation>

<Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ThingDef[defName="MUM_AutoSynthesizer"]/designationCategory</xpath>
    <value>
        <designationCategory>Ferny_ProcessingProduction</designationCategory>
    </value>
</Operation>

	<!-- Floors (TerrainDef) -->
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/TerrainDef[defName="MUM_ComfortWeaveCarpet" or defName="MUM_FineComfortWeaveCarpet"]/designationCategory</xpath>
		<value><designationCategory>Ferny_FloorsCarpet</designationCategory></value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/TerrainDef[defName="MUM_TemperedSteelFloor"]/designationCategory</xpath>
		<value><designationCategory>Ferny_FloorsMetal</designationCategory></value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/TerrainDef[defName="MUM_CompositeStoneFloor" or defName="MUM_FineCompositeStoneFloor"]/designationCategory</xpath>
		<value><designationCategory>Ferny_FloorsStone</designationCategory></value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/TerrainDef[defName="MUM_RefinedWoodFloor"]/designationCategory</xpath>
		<value><designationCategory>Ferny_FloorsWood</designationCategory></value>
	</Operation>
</Patch>
