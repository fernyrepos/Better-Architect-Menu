<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- Remove DMSE Decoration category -->
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/DesignationCategoryDef[defName="DMSE_Category"]</xpath>
    </Operation>

	<!-- Generated from BA_TreeExport: buildings left in a Misc/unsorted menu -->

	<!-- Ferny_DecoOutdoor -->
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="DMSE_lathedeco"]/designationCategory</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="DMSE_lathedeco"]/designationCategory</xpath>
			<value><designationCategory>Ferny_DecoOutdoor</designationCategory></value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>Defs/ThingDef[defName="DMSE_lathedeco"]</xpath>
			<value><designationCategory>Ferny_DecoOutdoor</designationCategory></value>
		</nomatch>
	</Operation>

	<!-- Ferny_SpacePower -->
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="DMSE_FusionCore"]/designationCategory</xpath>
		<value><designationCategory>Ferny_SpacePower</designationCategory></value>
	</Operation>

	<!-- Ferny_SpaceVacuum -->
