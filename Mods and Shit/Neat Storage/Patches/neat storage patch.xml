<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- GENERAL -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="sbz_DisplayTable" or defName="sbz_RoundPedestal"]</xpath>
        <value>
            <designationCategory>Ferny_GeneralStorage</designationCategory>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[@Name="sbzDisplayShelfBase"]</xpath>
        <value>
            <designationCategory>Ferny_GeneralStorage</designationCategory>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[@Name="sbzCrateBase"]</xpath>
        <value>
            <designationCategory>Ferny_GeneralStorage</designationCategory>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="sbz_Safe"]</xpath>
        <value>
            <designationCategory>Ferny_GeneralStorage</designationCategory>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="sbz_Drum"]</xpath>
        <value>
            <designationCategory>Ferny_GeneralStorage</designationCategory>
        </value>
    </Operation>

    <!-- RESOURCE STORAGE -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="sbz_TextileRack"]</xpath>
        <value>
            <designationCategory>Ferny_ResourcesStorage</designationCategory>
        </value>
    </Operation>
     
    <!-- FOOD STORAGE -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="sbz_MeatHook"]</xpath>
        <value>
            <designationCategory>Ferny_FoodStorage</designationCategory>
        </value>
    </Operation>

    <!-- GEAR STORAGE -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[@Name="sbzWeaponRackBase"]</xpath>
        <value>
            <designationCategory>Ferny_GearStorage</designationCategory>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="sbz_WeaponRack"]</xpath>
        <value>
            <designationCategory>Ferny_GearStorage</designationCategory>
        </value>
    </Operation>

    <!-- ReelStorageNewBarrel -->

	<!-- Ferny_FoodStorage -->
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="sbz_CorpseSpot"]/designationCategory</xpath>
		<value><designationCategory>Ferny_FoodStorage</designationCategory></value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<success>Always</success>
		<xpath>Defs/ThingDef[(defName="sbz_CorpseSpot") and not(designationCategory)]</xpath>
		<value><designationCategory>Ferny_FoodStorage</designationCategory></value>
	</Operation>
	<!-- Ferny_GearStorage -->
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="sbz_HangerShelf" or defName="sbz_WideHangerShelf"]/designationCategory</xpath>
		<value><designationCategory>Ferny_GearStorage</designationCategory></value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<success>Always</success>
		<xpath>Defs/ThingDef[(defName="sbz_HangerShelf" or defName="sbz_WideHangerShelf") and not(designationCategory)]</xpath>
		<value><designationCategory>Ferny_GearStorage</designationCategory></value>
	</Operation>
</Patch>
