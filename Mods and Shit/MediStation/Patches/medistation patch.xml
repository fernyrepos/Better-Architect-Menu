    <success>Always</success>
    <xpath>Defs/ThingDef[defName="MS_MediStation"]/designationCategory</xpath>
    <value>
      <designationCategory>Ferny_Medical</designationCategory>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ThingDef[defName="MS_GojuiceStation" or defName="MS_WakeupDispenser" or defName="MS_YayoCoffeeMachine"]/designationCategory</xpath>
    <value>
      <designationCategory>Ferny_Medical</designationCategory>
    </value>
  </Operation>

</Patch>
