<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Ferny_FoodStorage : 1 -->
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="FFE_Minibar"]/designationCategory</xpath>
		<value><designationCategory>Ferny_FoodStorage</designationCategory></value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<success>Always</success>
		<xpath>Defs/ThingDef[(defName="FFE_Minibar") and not(designationCategory)]</xpath>
		<value><designationCategory>Ferny_FoodStorage</designationCategory></value>
	</Operation>
</Patch>
