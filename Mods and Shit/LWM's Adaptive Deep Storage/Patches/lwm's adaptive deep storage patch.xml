<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Ferny_FoodStorage : 3 -->
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="ASF_Basket" or defName="ASF_MeatHook" or defName="ASF_TrayRack"]/designationCategory</xpath>
		<value><designationCategory>Ferny_FoodStorage</designationCategory></value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<success>Always</success>
		<xpath>Defs/ThingDef[(defName="ASF_Basket" or defName="ASF_MeatHook" or defName="ASF_TrayRack") and not(designationCategory)]</xpath>
		<value><designationCategory>Ferny_FoodStorage</designationCategory></value>
	</Operation>
