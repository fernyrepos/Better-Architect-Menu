<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[@ParentName="ASNeolithicBasketThingBase"]</xpath>
        <value>
            <designationCategory>Ferny_GeneralStorage</designationCategory>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[@ParentName="ASNeolithicChunkStorageBase"]</xpath>
        <value>
            <designationCategory>Ferny_ResourcesStorage</designationCategory>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="ASNeolithicHayPile"]</xpath>
        <value>
            <designationCategory>Ferny_ResourcesStorage</designationCategory>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[@ParentName="ASNeolithicLargePotThingBase" or defName="ASNeolithicMealShelf"]</xpath>
        <value>
            <designationCategory>Ferny_FoodStorage</designationCategory>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[@ParentName="ASNeolithicPlinthBase"]</xpath>
        <value>
            <designationCategory>Ferny_GeneralStorage</designationCategory>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[@ParentName="ASNeolithicTextileBundleBase"]</xpath>
        <value>
            <designationCategory>Ferny_ResourcesStorage</designationCategory>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="ASNeolithicWoodPile"]</xpath>
        <value>
            <designationCategory>Ferny_ResourcesStorage</designationCategory>
        </value>
    </Operation>


<!-- Better Architect : batiments non ranges (export du 04/11) -->
	<!-- Ferny_FoodStorage -->
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="ASNeolithicLargePot" or defName="ASNeolithicLargePotStone"]/designationCategory</xpath>
		<value><designationCategory>Ferny_FoodStorage</designationCategory></value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<success>Always</success>
		<xpath>Defs/ThingDef[(defName="ASNeolithicLargePot" or defName="ASNeolithicLargePotStone") and not(designationCategory)]</xpath>
		<value><designationCategory>Ferny_FoodStorage</designationCategory></value>
	</Operation>
	<!-- Ferny_GeneralStorage -->
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="ASNeolithicBasketFabric" or defName="ASNeolithicBasketWoody" or defName="ASNeolithicChunkStorage" or defName="ASNeolithicPlinthStone" or defName="ASNeolithicPlinthWoody" or defName="ASNeolithicTextileBundleFabric" or defName="ASNeolithicTextileBundleLeather"]/designationCategory</xpath>
		<value><designationCategory>Ferny_GeneralStorage</designationCategory></value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<success>Always</success>
		<xpath>Defs/ThingDef[(defName="ASNeolithicBasketFabric" or defName="ASNeolithicBasketWoody" or defName="ASNeolithicChunkStorage" or defName="ASNeolithicPlinthStone" or defName="ASNeolithicPlinthWoody" or defName="ASNeolithicTextileBundleFabric" or defName="ASNeolithicTextileBundleLeather") and not(designationCategory)]</xpath>
		<value><designationCategory>Ferny_GeneralStorage</designationCategory></value>
	</Operation>
</Patch>