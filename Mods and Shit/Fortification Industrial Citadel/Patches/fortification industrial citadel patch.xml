<?xml version="1.0" encoding="utf-8"?>
<Patch>
	
<!-- Move category to FIGHT -->
	
	<Operation Class="PatchOperationAddModExtension">
		<success>Always</success>
		<xpath>Defs/DesignationCategoryDef[defName="FTC_PermanentStructure"]</xpath>
		<value>
			<li Class="BetterArchitect.NestedCategoryExtension">
				<parentCategory>Security</parentCategory>
			</li>
		</value>
	</Operation>
	
<!-- WEAPONS -->

	<Operation Class="PatchOperationAdd">
		<success>Always</success>
		<xpath>Defs/ThingDef[@ParentName="FTC_BasePermanentBunker"]</xpath>
