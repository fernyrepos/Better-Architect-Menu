    <value>
      <designationCategory>Ferny_Prisoners</designationCategory>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/ThingDef[@Name="CE_CageBase"]/designationCategory</xpath>
