      <designationCategory>Ferny_Prisoners</designationCategory>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>Defs/ThingDef[defName="CE_WallMountedCot"]</xpath>
    <value>
      <designationCategory>Ferny_Bedroom</designationCategory>
    </value>
  </Operation>

</Patch>
