    <xpath>Defs/Vehicles.VehicleBuildDef[defName="RT_MATV_Vehicle_Blueprint"]</xpath>
    <value>
      <designationCategory>Ferny_MilitaryTransport</designationCategory>
    </value>
  </Operation>

</Patch>
