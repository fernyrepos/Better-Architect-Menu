<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- Remove Building(Dev) category -->
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/DesignationCategoryDef[defName="FFF_DevCategory"]</xpath>
    </Operation>

	<!-- Generated from BA_TreeExport: buildings left in a Misc/unsorted menu -->

	<!-- Ferny_Doors -->
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="FFF_RCdoor"]/designationCategory</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="FFF_RCdoor"]/designationCategory</xpath>
			<value><designationCategory>Ferny_Doors</designationCategory></value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>Defs/ThingDef[defName="FFF_RCdoor"]</xpath>
			<value><designationCategory>Ferny_Doors</designationCategory></value>
		</nomatch>
	</Operation>

