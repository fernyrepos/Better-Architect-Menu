<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Generated from BA_TreeExport: buildings left in a Misc/unsorted menu -->

	<!-- Ideology (Colons > Culture) -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Ideology</li>
		</mods>
		<match Class="PatchOperationConditional">
			<success>Always</success>
			<xpath>Defs/ThingDef[defName="ReviaBloodSigil"]/designationCategory</xpath>
			<match Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="ReviaBloodSigil"]/designationCategory</xpath>
				<value><designationCategory>Ideology</designationCategory></value>
			</match>
			<nomatch Class="PatchOperationAdd">
				<success>Always</success>
				<xpath>Defs/ThingDef[defName="ReviaBloodSigil"]</xpath>
				<value><designationCategory>Ideology</designationCategory></value>
			</nomatch>
		</match>
	</Operation>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Ideology</li>
		</mods>
		<match Class="PatchOperationConditional">
			<success>Always</success>
			<xpath>Defs/ThingDef[defName="ReviaSacrificeSpot"]/designationCategory</xpath>
			<match Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="ReviaSacrificeSpot"]/designationCategory</xpath>
				<value><designationCategory>Ideology</designationCategory></value>
			</match>
			<nomatch Class="PatchOperationAdd">
				<success>Always</success>
				<xpath>Defs/ThingDef[defName="ReviaSacrificeSpot"]</xpath>
				<value><designationCategory>Ideology</designationCategory></value>
			</nomatch>
		</match>
	</Operation>
</Patch>
