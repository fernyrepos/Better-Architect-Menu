<?xml version="1.0" encoding="utf-8" ?>
<Patch>


<!-- WALLS -->
                <Operation Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="DA_OssuaryWall"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Ferny_Walls</designationCategory>
                    </value>
                </Operation>

                <Operation Class="PatchOperationFindMod">
                    <mods>
                    <li>Progression: Aesthetics</li>
                    </mods>
                    <match Class="PatchOperationSequence">
                    <operations>
                        <li Class="PatchOperationReplace">
                        <success>Always</success>
                        <xpath>Defs/ThingDef[defName="DA_OssuaryWall"]/designationCategory</xpath>
                        <value>
                            <designationCategory></designationCategory>
                        </value>
                        </li>
                    </operations>
                    </match>
                </Operation>


<!-- LIGHTING -->
                <Operation Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[@Name="DA_CandelabraBase"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Ferny_Lighting</designationCategory>
                    </value>
                </Operation>
                <Operation Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[@Name="DA_SepulchralBrazierBase"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Ferny_Lighting</designationCategory>
                    </value>
                </Operation>
                <Operation Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[@Name="SepulchralStatueBase"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Ferny_Lighting</designationCategory>
                    </value>
                </Operation>
                <Operation Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[@Name="DA_CandleBase"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Ferny_Lighting</designationCategory>
                    </value>
                </Operation>
                <Operation Class="PatchOperationRemove">
                    <success>Always</success>
                    <xpath>Defs/ThingDef[@Name="DA_CandleBase"]/designatorDropdown</xpath>
                </Operation>

<!-- MEMORIAL -->
                <Operation Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="DA_Coffin"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Ferny_Memorial</designationCategory>
                    </value>
                </Operation>
  
                <Operation Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="DA_GrandSarcophagus"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Ferny_Memorial</designationCategory>
                    </value>
                </Operation>
  
                <Operation Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="DA_BurialUrn"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Ferny_Memorial</designationCategory>
                    </value>
                </Operation>

                <Operation Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="DA_WallTomb"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Ferny_Memorial</designationCategory>
                    </value>
                </Operation>
	
<!-- ART -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="DA_StatueBase"]/designationCategory</xpath>
		<value>
			<designationCategory>Ferny_DecoArt</designationCategory>
		</value>
	</Operation>

	<!-- Additional buildings sorted (generated from an in-game export of the architect tree) -->
<!-- Ferny_DecoArt -->
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="DA_DemonStatue"]/designationCategory</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="DA_DemonStatue"]/designationCategory</xpath>
			<value><designationCategory>Ferny_DecoArt</designationCategory></value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>Defs/ThingDef[defName="DA_DemonStatue"]</xpath>
			<value><designationCategory>Ferny_DecoArt</designationCategory></value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="DA_GargoyleStatue"]/designationCategory</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="DA_GargoyleStatue"]/designationCategory</xpath>
			<value><designationCategory>Ferny_DecoArt</designationCategory></value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>Defs/ThingDef[defName="DA_GargoyleStatue"]</xpath>
			<value><designationCategory>Ferny_DecoArt</designationCategory></value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="DA_ImpStatue"]/designationCategory</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="DA_ImpStatue"]/designationCategory</xpath>
			<value><designationCategory>Ferny_DecoArt</designationCategory></value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>Defs/ThingDef[defName="DA_ImpStatue"]</xpath>
			<value><designationCategory>Ferny_DecoArt</designationCategory></value>
		</nomatch>
	</Operation>

	<!-- Ferny_Memorial -->
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>Defs/ThingDef[defName="DA_HeroicMemorial"]/designationCategory</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="DA_HeroicMemorial"]/designationCategory</xpath>
			<value><designationCategory>Ferny_Memorial</designationCategory></value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>Defs/ThingDef[defName="DA_HeroicMemorial"]</xpath>
			<value><designationCategory>Ferny_Memorial</designationCategory></value>
		</nomatch>
	</Operation>
</Patch>
